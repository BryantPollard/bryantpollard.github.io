@prefix : <https://bryantpollard.github.io/neon-epn/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://bryantpollard.github.io/neon-epn/ontology#> .

<https://bryantpollard.github.io/neon-epn/ontology> rdf:type owl:Ontology ;
                                                     owl:versionIRI <https://bryantpollard.github.io/neon-epn/ontology/0.6.0> ;
                                                     owl:imports <http://www.w3.org/ns/sosa/> ;
                                                     <http://purl.org/dc/terms/abstract> "Semantic layer integrating wildlife pathogen, vector, phenology and climate observations from ecological monitoring networks, modelled on SOSA."@en ;
                                                     <http://purl.org/dc/terms/bibliographicCitation> "Pollard, B. (2026). NEON-EPN Ontology, version 0.6.0. https://bryantpollard.github.io/neon-epn/ontology" ;
                                                     <http://purl.org/dc/terms/created> "2026-09-04"^^xsd:date ;
                                                     <http://purl.org/dc/terms/creator> _:genid1 ;
                                                     <http://purl.org/dc/terms/description> "An OWL ontology for wildlife pathogen surveillance, vector abundance and plant phenology observed across a continental ecological monitoring network. Host-pathogen assays, drag-cloth vector sampling, phenophase checks and sensor telemetry are modelled as specialisations of the W3C SOSA observation pattern over a spatial hierarchy of domains, sites and plots, so that products sharing no identifier in their published form become jointly queryable. Observations record the contributing network, allowing records from more than one monitoring programme to be integrated without losing provenance."@en ;
                                                     <http://purl.org/dc/terms/issued> "2026-09-14"^^xsd:date ;
                                                     <http://purl.org/dc/terms/language> "en" ;
                                                     <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                     <http://purl.org/dc/terms/modified> "2026-09-14"^^xsd:date ;
                                                     <http://purl.org/dc/terms/publisher> _:genid2 ;
                                                     <http://purl.org/dc/terms/rights> "Released under CC BY 4.0. Underlying NEON and USA-NPN data are also CC BY 4.0."@en ;
                                                     <http://purl.org/dc/terms/source> <https://www.neonscience.org/> ,
                                                                                       <https://www.usanpn.org/> ;
                                                     <http://purl.org/dc/terms/title> "NEON-EPN Ontology: National Ecological Observatory Network Eco-Pathogen Network"@en ;
                                                     <http://purl.org/vocab/vann/preferredNamespacePrefix> "neonepn" ;
                                                     <http://purl.org/vocab/vann/preferredNamespaceUri> "https://bryantpollard.github.io/neon-epn/ontology#" ;
                                                     rdfs:comment """Semantic layer (TBox) for the NEON-EPN capstone project. Models NEON
host-pathogen sampling events and continuous climate sensor telemetry over a dynamic
spatial hierarchy, as specializations of the W3C SOSA observation pattern. Serves as the
single schema that governs RDF ingestion (Stage 2), SHACL validation (Stage 3), SPARQL
serving (Stage 4), and the flattened Temporal Graph Benchmark export (Stage 5).

Reuse policy: SOSA is imported in full - Observation, Sampling, FeatureOfInterest,
Sensor, resultTime and hasResult are all load-bearing here. Everything else is
soft-referenced by IRI (MIREOT-style) rather than imported: GeoSPARQL, QUDT,
NCBITaxon, ENVO, the Plant Phenology Ontology (PPO, CC BY 3.0), and the three
OWL-Time terms below, and PROV-O for the contributing network. Phenophase
individuals carry skos:closeMatch links to PPO, which was designed to
accommodate both NEON and USA-NPN status-based monitoring; that shared
vocabulary is what allows observations from the two networks to be queried
together without a bespoke crosswalk. Importing OWL-Time in full
pulled in Duration, GeneralDurationDescription, DateTimeDescription, TRS and a dozen
other classes that no instance data ever used, tripling the apparent size of the
model for no benefit."""@en ;
                                                     rdfs:seeAlso <https://bryantpollard.github.io/> ,
                                                                  <https://github.com/BryantPollard/neon-epn> ,
                                                                  <https://www.neonscience.org/> ;
                                                     owl:priorVersion <https://bryantpollard.github.io/neon-epn/ontology/0.5.0> ;
                                                     owl:versionInfo "0.6.0" ;
                                                     <http://www.w3.org/ns/prov#wasDerivedFrom> <http://purl.obolibrary.org/obo/ppo.owl> ,
                                                                                                <http://www.w3.org/ns/sosa/> ;
                                                     <http://www.w3.org/ns/prov#wasGeneratedBy> _:genid3 ;
                                                     <https://schema.org/codeRepository> <https://github.com/BryantPollard/neon-epn> .

_:genid1 rdf:type <http://xmlns.com/foaf/0.1/Person> ;
          <http://xmlns.com/foaf/0.1/name> "Bryant Pollard" .

_:genid2 rdf:type <http://xmlns.com/foaf/0.1/Organization> ;
          <http://xmlns.com/foaf/0.1/name> "Clemson University" .

_:genid3 rdf:type <http://www.w3.org/ns/prov#Activity> ;
          rdfs:comment "Developed against seven competency questions, formalised in OWL, and evaluated by competency-question coverage, structural metrics, annotation coverage and a SHACL gate over the instantiated graph."@en ;
          rdfs:label "NEON-EPN ontology development"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/language
<http://purl.org/dc/terms/language> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
<http://www.w3.org/ns/prov#wasDerivedFrom> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#wasGeneratedBy
<http://www.w3.org/ns/prov#wasGeneratedBy> rdf:type owl:AnnotationProperty .


###  https://schema.org/codeRepository
<https://schema.org/codeRepository> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.opengis.net/ont/geosparql#sfWithin
<http://www.opengis.net/ont/geosparql#sfWithin> rdf:type owl:ObjectProperty .


###  http://www.w3.org/2006/time#hasBeginning
<http://www.w3.org/2006/time#hasBeginning> rdf:type owl:ObjectProperty ;
                                           rdfs:isDefinedBy <http://www.w3.org/2006/time#> ;
                                           rdfs:label "has beginning"@en .


###  http://www.w3.org/2006/time#hasEnd
<http://www.w3.org/2006/time#hasEnd> rdf:type owl:ObjectProperty ;
                                     rdfs:isDefinedBy <http://www.w3.org/2006/time#> ;
                                     rdfs:label "has end"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#collectedAt
:collectedAt rdf:type owl:ObjectProperty ;
             rdfs:domain :TickSample ;
             rdfs:range :SpatialUnit ;
             rdfs:comment "The spatial unit where a tick sample was collected."@en ;
             rdfs:label "collected at"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#deployedAt
:deployedAt rdf:type owl:ObjectProperty ;
            rdfs:domain :ClimateSensor ;
            rdfs:range :SpatialUnit ;
            rdfs:comment "The spatial unit where a sensor is installed."@en ;
            rdfs:label "deployed at"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#detectedAt
:detectedAt rdf:type owl:ObjectProperty ;
            rdfs:domain :PathogenTaxon ;
            rdfs:range :SpatialUnit ;
            rdfs:comment "Asserted pathogen-place detection edge: the pathogen taxon was detected in a vector sample collected at this spatial unit. Materialized from each TickPathogenAssay whose hasAssayResult is Detected. This is the vector-borne counterpart of detectedIn and the second link-prediction target of the temporal graph."@en ;
            rdfs:label "detected at"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#detectedIn
:detectedIn rdf:type owl:ObjectProperty ;
            rdfs:domain :PathogenTaxon ;
            rdfs:range :HostIndividual ;
            rdfs:comment "Asserted pathogen-host detection edge: the pathogen taxon was detected in the host individual. Materialized during Stage 2 from each PathogenAssay whose hasAssayResult is Detected; this is the primary positive edge type of the temporal graph and the main link-prediction target."@en ;
            rdfs:label "detected in"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#expressedAt
:expressedAt rdf:type owl:ObjectProperty ;
             rdfs:domain :Phenophase ;
             rdfs:range :SpatialUnit ;
             rdfs:comment "Asserted phenophase-place edge: this phenophase was observed expressed at this spatial unit. Materialized from observations whose status is Expressed. Densely labelled, like observedAt, and it supplies the seasonal timing against which vector activity and pathogen detection can be compared."@en ;
             rdfs:label "expressed at"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#fromDragSample
:fromDragSample rdf:type owl:ObjectProperty ;
                rdfs:domain :VectorOccurrence ;
                rdfs:range :DragSample ;
                rdfs:comment "Links an identified tick occurrence back to the bout that collected it, so that effort and sampled area remain recoverable."@en ;
                rdfs:label "from drag sample"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#hasAssayResult
:hasAssayResult rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :PathogenTest ;
                rdfs:range :AssayResult ;
                rdfs:comment "The single outcome of an assay, drawn from the closed AssayResult value set."@en ;
                rdfs:label "has assay result"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#hasPhenophaseStatus
:hasPhenophaseStatus rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :PhenophaseObservation ;
                     rdfs:range :PhenophaseStatus ;
                     rdfs:comment "Relates a phenophase observation to its outcome. Functional: a single check yields one status."@en ;
                     rdfs:label "has phenophase status"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#hostOf
:hostOf rdf:type owl:ObjectProperty ;
        owl:inverseOf :detectedIn ;
        rdfs:comment "Inverse of detectedIn: relates a host individual to a pathogen found in it."@en ;
        rdfs:label "host of"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#nearFieldSite
:nearFieldSite rdf:type owl:ObjectProperty ;
               rdfs:domain :ObservationSite ;
               rdfs:range :FieldSite ;
               rdfs:comment "Asserted proximity between an external observation site and a NEON field site, materialized when the two lie within a stated distance. Deliberately NOT withinSpatialUnit: an external site is not contained by a NEON site, and treating proximity as containment would license false inference through the transitive spatial hierarchy."@en ;
               rdfs:label "near field site"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#observedAt
:observedAt rdf:type owl:ObjectProperty ;
            rdfs:domain :VectorTaxon ;
            rdfs:range :SpatialUnit ;
            rdfs:comment "Asserted vector-presence edge: this tick species was collected at this spatial unit. Materialized from drag samples in which the taxon was identified. Unlike detectedIn and detectedAt, which record rare pathogen detections, this relation is densely labelled - roughly half of all bouts find the target taxa - which makes it a well-powered companion task on the same graph."@en ;
            rdfs:label "observed at"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#observedByNetwork
:observedByNetwork rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                   rdfs:range :ObservationNetwork ;
                   rdfs:comment "The programme whose protocol produced this observation. Present on every observation once more than one source is integrated, so that provenance survives the merge."@en ;
                   rdfs:label "observed by network"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#observedPhenophase
:observedPhenophase rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :PhenophaseObservation ;
                    rdfs:range :Phenophase ;
                    rdfs:comment "The phenophase being checked. Functional, and drawn from the closed set NEON records."@en ;
                    rdfs:label "observed phenophase"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ofPlantTaxon
:ofPlantTaxon rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :PlantIndividual ;
              rdfs:range :PlantTaxon ;
              rdfs:comment "The species of a marked plant. Functional, and shared across both contributing networks so that taxa are not duplicated per source."@en ;
              rdfs:label "of plant taxon"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ofTaxon
:ofTaxon rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :HostIndividual ;
         rdfs:range :HostTaxon ;
         rdfs:comment "Links an individual organism to its species-level taxon."@en ;
         rdfs:label "of taxon"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ofVectorTaxon
:ofVectorTaxon rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :VectorOccurrence ;
               rdfs:range :VectorTaxon ;
               rdfs:comment "The tick species identified in a drag-cloth collection. Functional: one occurrence records one taxon."@en ;
               rdfs:label "of vector taxon"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#sampledAt
:sampledAt rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( <http://www.w3.org/ns/sosa/Observation>
                                       <http://www.w3.org/ns/sosa/Sampling>
                                     )
                       ] ;
           rdfs:range :SpatialUnit ;
           rdfs:comment "The spatial unit at which an observation or sampling act occurred. Combined with withinSpatialUnit, every event resolves upward to site and domain."@en ;
           rdfs:label "sampled at"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#testedForPathogen
:testedForPathogen rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :PathogenTest ;
                   rdfs:range :PathogenTaxon ;
                   rdfs:comment "The single pathogen taxon targeted by an assay."@en ;
                   rdfs:label "tested for pathogen"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#withinSpatialUnit
:withinSpatialUnit rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.opengis.net/ont/geosparql#sfWithin> ;
                   rdf:type owl:TransitiveProperty ;
                   rdfs:domain :SpatialUnit ;
                   rdfs:range :SpatialUnit ;
                   rdfs:comment "Transitive containment along the NEON spatial hierarchy (plot within site within domain). Sub-property of GeoSPARQL sfWithin so spatial reasoners interoperate."@en ;
                   rdfs:label "within spatial unit"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/2006/time#inXSDDateTimeStamp
<http://www.w3.org/2006/time#inXSDDateTimeStamp> rdf:type owl:DatatypeProperty ;
                                                 rdfs:isDefinedBy <http://www.w3.org/2006/time#> ;
                                                 rdfs:label "in XSD date-time stamp"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#adultCount
:adultCount rdf:type owl:DatatypeProperty ;
            rdfs:domain :DragSample ;
            rdfs:range xsd:integer ;
            rdfs:comment "Adult ticks collected in a drag bout. Distinct from nymphs and larvae, which differ in both host preference and epidemiological importance."@en ;
            rdfs:label "adult count"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#adultTicksAttached
:adultTicksAttached rdf:type owl:DatatypeProperty ;
                    rdfs:domain :CaptureEvent ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Presence of attached ticks by life stage at capture. Bridges hosts to the vector layer: an animal carrying ticks links that host individual to the tick populations sampled by drag cloth at the same plot."@en ;
                    rdfs:label "adult ticks attached"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#attachedTickCount
:attachedTickCount rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CaptureEvent ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Number of attached ticks counted at capture (NEON tickNumber). Recorded on only a small fraction of captures; absence means not counted, not zero."@en ;
                   rdfs:label "attached tick count"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#distanceToFieldSiteKm
:distanceToFieldSiteKm rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ObservationSite ;
                       rdfs:range xsd:double ;
                       rdfs:comment "Great-circle distance to the nearest NEON field site. Recorded so that a user can choose a proximity threshold rather than inherit the one used at ingestion."@en ;
                       rdfs:label "distance to field site (km)"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#individualCount
:individualCount rdf:type owl:DatatypeProperty ;
                 rdfs:domain :TickSample ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Number of tick individuals in the tested subsample. Uniformly 1 in the NEON data examined; retained so that pooled testing, which the source field permits, would be representable without a schema change."@en ;
                 rdfs:label "individual count"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#larvaCount
:larvaCount rdf:type owl:DatatypeProperty ;
            rdfs:domain :DragSample ;
            rdfs:range xsd:integer ;
            rdfs:comment "Larval ticks collected in a drag bout. Larvae hatch uninfected, so their host associations determine whether the transmission cycle establishes."@en ;
            rdfs:label "larva count"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#larvalTicksAttached
:larvalTicksAttached rdf:type owl:DatatypeProperty ;
                     rdfs:domain :CaptureEvent ;
                     rdfs:range xsd:boolean ;
                     rdfs:comment "Whether larval ticks were attached to a captured animal. NEON records presence as Y/N, not as a count; parsing it as an integer silently discards every value."@en ;
                     rdfs:label "larval ticks attached"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#lifeStage
:lifeStage rdf:type owl:DatatypeProperty ;
           rdfs:domain :VectorOccurrence ;
           rdfs:range xsd:string ;
           rdfs:comment "Life stage or sex as recorded by NEON: Larva, Nymph, Female, Male."@en ;
           rdfs:label "life stage"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#neonDomainCode
:neonDomainCode rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :EcoDomain ;
                rdfs:range xsd:string ;
                rdfs:comment "NEON domain identifier, e.g., 'D01'."@en ;
                rdfs:label "NEON domain code"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#neonSiteCode
:neonSiteCode rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :FieldSite ;
              rdfs:range xsd:string ;
              rdfs:comment "Four-letter NEON site identifier, e.g., 'HARV'."@en ;
              rdfs:label "NEON site code"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#nymphCount
:nymphCount rdf:type owl:DatatypeProperty ;
            rdfs:domain :DragSample ;
            rdfs:range xsd:integer ;
            rdfs:comment "Nymphs are the life stage responsible for most human Lyme transmission, so nymphal presence is the epidemiologically relevant target."@en ;
            rdfs:label "nymph count"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#nymphalTicksAttached
:nymphalTicksAttached rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CaptureEvent ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Whether nymphal ticks were attached to a captured animal. Recorded as Y/N. Nymphs cause most human Lyme transmission, so their presence on reservoir hosts is the epidemiologically informative stage."@en ;
                      rdfs:label "nymphal ticks attached"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#phenophaseIntensity
:phenophaseIntensity rdf:type owl:DatatypeProperty ;
                     rdfs:domain :PhenophaseObservation ;
                     rdfs:range xsd:string ;
                     rdfs:comment "NEON's ordinal abundance band for the phase when expressed, for example '< 5%' or '25-49%'. Kept as recorded rather than coerced to a number, since the bands are not evenly spaced."@en ;
                     rdfs:label "phenophase intensity"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#plotId
:plotId rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Plot ;
        rdfs:range xsd:string ;
        rdfs:comment "NEON plot identifier, e.g., 'HARV_001'."@en ;
        rdfs:label "plot identifier"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#sampledAreaSqM
:sampledAreaSqM rdf:type owl:DatatypeProperty ;
                rdfs:domain :DragSample ;
                rdfs:range xsd:double ;
                rdfs:comment "Area covered by the drag cloth, so counts can be expressed as density rather than raw abundance when effort varies."@en ;
                rdfs:label "sampled area (m2)"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#tagId
:tagId rdf:type owl:DatatypeProperty ;
       rdfs:domain :HostIndividual ;
       rdfs:range xsd:string ;
       rdfs:comment "NEON mark-recapture tag for an individual animal."@en ;
       rdfs:label "tag identifier"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#targetTaxaPresent
:targetTaxaPresent rdf:type owl:DatatypeProperty ;
                   rdfs:domain :DragSample ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Whether any target tick taxa were collected in this bout. The observed negative that makes vector presence a balanced prediction task."@en ;
                   rdfs:label "target taxa present"@en .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/QuantityValue
<http://qudt.org/schema/qudt/QuantityValue> rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class .


###  http://www.w3.org/2006/time#Instant
<http://www.w3.org/2006/time#Instant> rdf:type owl:Class ;
                                      rdfs:isDefinedBy <http://www.w3.org/2006/time#> ;
                                      rdfs:label "Instant"@en .


###  http://www.w3.org/2006/time#Interval
<http://www.w3.org/2006/time#Interval> rdf:type owl:Class ;
                                       rdfs:comment "A temporal entity with extent. Used here for the span covered by a daily climate aggregate."@en ;
                                       rdfs:isDefinedBy <http://www.w3.org/2006/time#> ;
                                       rdfs:label "Interval"@en .


###  http://www.w3.org/ns/prov#Activity
<http://www.w3.org/ns/prov#Activity> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class .


###  https://bryantpollard.github.io/neon-epn/ontology#AssayResult
:AssayResult rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :Detected
                                               :Inconclusive
                                               :NotDetected
                                             )
                                 ] ;
             rdfs:comment "Closed value set for pathogen assay outcomes. Closure is enforced here by owl:oneOf and again defensively by SHACL in Stage 3."@en ;
             rdfs:label "Assay result"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#CaptureEvent
:CaptureEvent rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/sosa/Sampling> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                owl:someValuesFrom :HostIndividual
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :sampledAt ;
                                owl:someValuesFrom :Plot
                              ] ;
              rdfs:comment "A discrete NEON trapping/sampling act in which a host individual is captured at a plot at a point in time (sosa:resultTime)."@en ;
              rdfs:label "Capture event"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ClimateProperty
:ClimateProperty rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty> ;
                 rdfs:comment "An observable meteorological/soil property streamed by NEON instrumentation."@en ;
                 rdfs:label "Climate property"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ClimateReading
:ClimateReading rdf:type owl:Class ;
                rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                  owl:someValuesFrom <http://qudt.org/schema/qudt/QuantityValue>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.w3.org/ns/sosa/madeBySensor> ;
                                  owl:someValuesFrom :ClimateSensor
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                  owl:someValuesFrom :ClimateProperty
                                ] ;
                rdfs:comment "One measurement from the climate telemetry. Native-resolution readings carry sosa:resultTime (an instant). Daily aggregates additionally carry sosa:phenomenonTime pointing at a time:Interval spanning the day, because a daily mean is not observed at an instant. Results use QUDT QuantityValue (value + unit), or sosa:hasSimpleResult in lean mode."@en ;
                rdfs:label "Climate reading"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ClimateSensor
:ClimateSensor rdf:type owl:Class ;
               rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :deployedAt ;
                                 owl:someValuesFrom :SpatialUnit
                               ] ;
               rdfs:comment "A NEON instrument streaming climate readings from a deployment location."@en ;
               rdfs:label "Climate sensor"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#DragSample
:DragSample rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/sosa/Sampling> ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :sampledAt ;
                              owl:someValuesFrom :Plot
                            ] ;
            rdfs:comment "One drag-cloth sampling bout at a plot: a cloth of known area is dragged through vegetation and the ticks collected are counted by life stage. Recorded whether or not ticks are found, so absence is observed rather than inferred."@en ;
            rdfs:label "Drag sample"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#EcoDomain
:EcoDomain rdf:type owl:Class ;
           rdfs:subClassOf :SpatialUnit ;
           rdfs:comment "One of NEON's 20 ecoclimatic domains (e.g., D01 Northeast)."@en ;
           rdfs:label "Ecoclimatic domain"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#FieldSite
:FieldSite rdf:type owl:Class ;
           rdfs:subClassOf :SpatialUnit ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :withinSpatialUnit ;
                             owl:someValuesFrom :EcoDomain
                           ] ;
           rdfs:comment "A NEON field site (e.g., HARV, OSBS). Every field site lies within an ecoclimatic domain."@en ;
           rdfs:label "Field site"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#HostIndividual
:HostIndividual rdf:type owl:Class ;
                rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :ofTaxon ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :HostTaxon
                                ] ;
                owl:disjointWith :TickSample ;
                rdfs:comment "An individual captured/sampled organism (e.g., one tagged deer mouse). The feature of interest of pathogen assays."@en ;
                rdfs:label "Host individual"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#HostTaxon
:HostTaxon rdf:type owl:Class ;
           rdfs:subClassOf :Taxon ;
           rdfs:comment "A taxon acting as a pathogen host in this network (e.g., small mammal species sampled by NEON)."@en ;
           rdfs:label "Host taxon"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ObservationNetwork
:ObservationNetwork rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
                    rdfs:comment "A programme that collects observations to a defined protocol. Recorded so that records from different networks remain distinguishable after integration."@en ;
                    rdfs:label "Observation network"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#ObservationSite
:ObservationSite rdf:type owl:Class ;
                 rdfs:subClassOf :SpatialUnit ;
                 rdfs:comment "A location at which a network makes observations, where that location is not part of NEON's domain-site-plot hierarchy. USA-NPN stations are volunteer-chosen points, so they are related to NEON field sites by proximity rather than by containment."@en ;
                 rdfs:label "Observation site"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#PathogenAssay
:PathogenAssay rdf:type owl:Class ;
               rdfs:subClassOf :PathogenTest ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                 owl:someValuesFrom :HostIndividual
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                 owl:hasValue :PathogenPresence
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasAssayResult ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :AssayResult
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :testedForPathogen ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :PathogenTaxon
                               ] ;
               owl:disjointWith :TickPathogenAssay ;
               rdfs:comment "A laboratory test (e.g., qPCR/ELISA) of one host individual's blood sample for one pathogen taxon. Source: NEON rodent-borne pathogen status, linked to trapping by bloodSampleID."@en ;
               rdfs:label "Host pathogen assay"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#PathogenTaxon
:PathogenTaxon rdf:type owl:Class ;
               rdfs:subClassOf :Taxon ;
               rdfs:comment "A taxon acting as a pathogen or vector-borne agent tested for by NEON assays (e.g., Borrelia burgdorferi)."@en ;
               rdfs:label "Pathogen taxon"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#PathogenTest
:PathogenTest rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                owl:hasValue :PathogenPresence
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasAssayResult ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :AssayResult
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :testedForPathogen ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :PathogenTaxon
                              ] ;
              rdfs:comment "Any test for the presence of one pathogen taxon in one sampled entity, yielding exactly one closed-set result at a point in time. Specialized by PathogenAssay (host blood) and TickPathogenAssay (pooled tick subsample)."@en ;
              rdfs:label "Pathogen test"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#Phenophase
:Phenophase rdf:type owl:Class ;
            rdfs:comment "A recognisable stage in a plant's annual cycle, such as breaking leaf buds or open flowers. Members of a closed set defined by NEON's observation protocol."@en ;
            rdfs:label "Phenophase"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#PhenophaseObservation
:PhenophaseObservation rdf:type owl:Class ;
                       rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasPhenophaseStatus ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :PhenophaseStatus
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :observedPhenophase ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Phenophase
                                       ] ;
                       rdfs:comment "One check of whether one phenophase is currently expressed on one plant. Recorded on every visit whether or not the phase is present, so absence is observed rather than inferred, as with drag sampling. Carries neonepn:observedByNetwork, since both NEON and USA-NPN contribute observations of the same phenophases to this class."@en ;
                       rdfs:label "Phenophase observation"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#PhenophaseStatus
:PhenophaseStatus rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( :Expressed
                                                    :NotExpressed
                                                    :StatusUncertain
                                                  )
                                      ] ;
                  rdfs:comment "Whether a phenophase was observable on a plant at the moment of a visit. A closed set, so an unrecognised value is rejected at validation rather than propagating."@en ;
                  rdfs:label "Phenophase status"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#PlantIndividual
:PlantIndividual rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :ofPlantTaxon ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :PlantTaxon
                                 ] ;
                 rdfs:comment "A marked plant observed repeatedly through the season, identified by the contributing network's individual identifier. Unlike a host animal it is sessile, so its location is fixed and it is revisited on a schedule rather than recaptured by chance. Identifiers are network-scoped: a NEON individualID and a USA-NPN individual_id may collide numerically and are kept in separate IRI spaces."@en ;
                 rdfs:label "Plant individual"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#PlantTaxon
:PlantTaxon rdf:type owl:Class ;
            rdfs:subClassOf :Taxon ;
            rdfs:comment "A plant species under phenological observation, for example Quercus rubra or Acer rubrum."@en ;
            rdfs:label "Plant taxon"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#Plot
:Plot rdf:type owl:Class ;
      rdfs:subClassOf :SpatialUnit ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :withinSpatialUnit ;
                        owl:someValuesFrom :FieldSite
                      ] ;
      rdfs:comment "A sampling plot within a NEON field site (e.g., a small-mammal trapping grid)."@en ;
      rdfs:label "Plot"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#SpatialUnit
:SpatialUnit rdf:type owl:Class ;
             rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
             rdfs:comment "Any node of the NEON spatial hierarchy (ecoclimatic domain, field site, or plot). Subclass of geo:Feature so WKT geometries can be attached."@en ;
             rdfs:label "Spatial unit"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#Taxon
:Taxon rdf:type owl:Class ;
       rdfs:comment "A biological taxon referenced by the project. Individuals should carry a skos:exactMatch to the corresponding purl.obolibrary.org NCBITaxon IRI."@en ;
       rdfs:label "Taxon"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/NCBITaxon_1> .


###  https://bryantpollard.github.io/neon-epn/ontology#TickPathogenAssay
:TickPathogenAssay rdf:type owl:Class ;
                   rdfs:subClassOf :PathogenTest ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                     owl:someValuesFrom :TickSample
                                   ] ;
                   rdfs:comment "A laboratory test of one pooled tick subsample for one pathogen taxon. Source: NEON tick-borne pathogen status."@en ;
                   rdfs:label "Tick pathogen assay"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#TickSample
:TickSample rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :collectedAt ;
                              owl:someValuesFrom :SpatialUnit
                            ] ;
            rdfs:comment "A tick specimen collected by drag-cloth sampling at a plot and submitted for pathogen testing, identified by NEON subsampleID. In every NEON record examined (231,892 across 39 sites) individualCount is 1, so a sample is a single tick; the count is retained because the field permits pooling in principle. Unlike a host individual, a tick sample is an environmental sample with no tagged organism, so vector-borne detections attach to place rather than to an animal."@en ;
            rdfs:label "Tick sample"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#VectorOccurrence
:VectorOccurrence rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :ofVectorTaxon ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :VectorTaxon
                                  ] ;
                  rdfs:comment "Identification of one tick taxon (optionally at one life stage) within one drag sample, with the number of individuals counted."@en ;
                  rdfs:label "Vector occurrence"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#VectorTaxon
:VectorTaxon rdf:type owl:Class ;
             rdfs:subClassOf :Taxon ;
             rdfs:comment "A tick species that may transmit pathogens, identified from drag-cloth collections (e.g. Ixodes scapularis, Amblyomma americanum)."@en ;
             rdfs:label "Vector taxon"@en .


#################################################################
#    Individuals
#################################################################

###  https://bryantpollard.github.io/neon-epn/ontology#AirTemperature
:AirTemperature rdf:type owl:NamedIndividual ,
                         :ClimateProperty ;
                rdfs:comment "Air temperature at tower height. Note that ticks quest in the litter layer rather than two metres up, so this is a proxy for the microclimate they actually experience."@en ;
                rdfs:label "air temperature"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#BreakingLeafBuds
:BreakingLeafBuds rdf:type owl:NamedIndividual ,
                           :Phenophase ;
                  rdfs:comment "The canonical green-up indicator: the first date this is expressed marks the onset of the growing season. PPO:0001012 'breaking vegetative bud' carries 'breaking leaf bud' as an alternative label."@en ;
                  rdfs:label "Breaking leaf buds"@en ;
                  <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0001012> .


###  https://bryantpollard.github.io/neon-epn/ontology#ColoredLeaves
:ColoredLeaves rdf:type owl:NamedIndividual ,
                        :Phenophase ;
               rdfs:comment "Aligned to 'senescing true leaf present' (PPO:0002317). NEON scores leaf colour as the visible marker of senescence; PPO names the underlying state."@en ;
               rdfs:label "Colored leaves"@en ;
               <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0002317> .


###  https://bryantpollard.github.io/neon-epn/ontology#Detected
:Detected rdf:type owl:NamedIndividual ,
                   :AssayResult ;
          rdfs:comment "The assay found the pathogen in this sample."@en ;
          rdfs:label "detected"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#EmergingNeedles
:EmergingNeedles rdf:type owl:NamedIndividual ,
                          :Phenophase ;
                 rdfs:comment "Aligned to 'unfolding true leaf present' (PPO:0002314). PPO treats needles as vascular leaves and its unfolding stage explicitly covers conifers."@en ;
                 rdfs:label "Emerging needles"@en ;
                 <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0002314> .


###  https://bryantpollard.github.io/neon-epn/ontology#Expressed
:Expressed rdf:type owl:NamedIndividual ,
                    :PhenophaseStatus ;
           rdfs:comment "The phenophase is currently observable on the plant. Corresponds to PPO's 'present' traits, e.g. 'open flower present' (PPO:0002333) for OpenFlowers."@en ;
           rdfs:label "Expressed"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#FallingLeaves
:FallingLeaves rdf:type owl:NamedIndividual ,
                        :Phenophase ;
               rdfs:comment "Aligned to 'abscised leaf present' (PPO:0002357), which counts leaves shed within the current growing season."@en ;
               rdfs:label "Falling leaves"@en ;
               <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0002357> .


###  https://bryantpollard.github.io/neon-epn/ontology#Inconclusive
:Inconclusive rdf:type owl:NamedIndividual ,
                       :AssayResult ;
              rdfs:comment "The assay could not be resolved. Excluded from both positives and negatives rather than treated as an absence."@en ;
              rdfs:label "inconclusive"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#IncreasingLeafSize
:IncreasingLeafSize rdf:type owl:NamedIndividual ,
                             :Phenophase ;
                    rdfs:comment "Aligned to 'expanding true leaf present' (PPO:0002322)."@en ;
                    rdfs:label "Increasing leaf size"@en ;
                    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0002322> .


###  https://bryantpollard.github.io/neon-epn/ontology#InitialGrowth
:InitialGrowth rdf:type owl:NamedIndividual ,
                        :Phenophase ;
               rdfs:comment "NEON scores initial growth for grasses and forbs, where new basal or vegetative growth emerges without a distinct bud-break event. No PPO counterpart was found, so this individual is deliberately left unaligned rather than forced onto an approximate term."@en ;
               rdfs:label "Initial growth"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#Leaves
:Leaves rdf:type owl:NamedIndividual ,
                 :Phenophase ;
        rdfs:comment "Aligned to 'true leaf present' (PPO:0002313)."@en ;
        rdfs:label "Leaves"@en ;
        <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0002313> .


###  https://bryantpollard.github.io/neon-epn/ontology#NEON
:NEON rdf:type owl:NamedIndividual ,
               :ObservationNetwork ;
      rdfs:comment "Continental-scale observatory operated by Battelle under NSF cooperative agreement. Observations are made by trained technicians on fixed plots to a published protocol."@en ;
      rdfs:label "National Ecological Observatory Network"@en ;
      rdfs:seeAlso <https://www.neonscience.org/> .


###  https://bryantpollard.github.io/neon-epn/ontology#NotDetected
:NotDetected rdf:type owl:NamedIndividual ,
                      :AssayResult ;
             rdfs:comment "The assay was performed and did not find the pathogen. An observed absence, not a missing value: this is what makes prevalence computable, since it supplies the denominator."@en ;
             rdfs:label "not detected"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#NotExpressed
:NotExpressed rdf:type owl:NamedIndividual ,
                       :PhenophaseStatus ;
              rdfs:comment "The plant was checked and the phenophase was not observable. An observed absence, not a missing value; corresponds to PPO's 'absent' traits, e.g. 'open flower absent' (PPO:0002632)."@en ;
              rdfs:label "Not expressed"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#OpenFlowers
:OpenFlowers rdf:type owl:NamedIndividual ,
                      :Phenophase ;
             rdfs:comment "Aligned to 'open flower present' (PPO:0002333). The closest correspondence in the set."@en ;
             rdfs:label "Open flowers"@en ;
             <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0002333> .


###  https://bryantpollard.github.io/neon-epn/ontology#OpenPollenCones
:OpenPollenCones rdf:type owl:NamedIndividual ,
                          :Phenophase ;
                 rdfs:comment "Aligned to 'open microsporangiate strobilus' (PPO:0001047). PPO offers no paired presence trait for pollen cones, so the match is to the structure class itself."@en ;
                 rdfs:label "Open pollen cones"@en ;
                 <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0001047> .


###  https://bryantpollard.github.io/neon-epn/ontology#PathogenPresence
:PathogenPresence rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/ns/sosa/ObservableProperty> ;
                  rdfs:comment "The observable property measured by a pathogen assay: presence/absence of a target pathogen in a host individual or its sample."@en ;
                  rdfs:label "pathogen presence"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#Precipitation
:Precipitation rdf:type owl:NamedIndividual ,
                        :ClimateProperty ;
               rdfs:comment "Bulk precipitation from the weighing gauge (DP1.00044.001), which replaced the deprecated DP1.00006.001 in October 2025."@en ;
               rdfs:label "precipitation"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#RelativeHumidity
:RelativeHumidity rdf:type owl:NamedIndividual ,
                           :ClimateProperty ;
                  rdfs:comment "Relative humidity. Capacitive sensors read slightly above 100 percent in fog and frost; values to 105 percent are retained with a warning rather than discarded."@en ;
                  rdfs:label "relative humidity"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#SoilTemperature
:SoilTemperature rdf:type owl:NamedIndividual ,
                          :ClimateProperty ;
                 rdfs:comment "Soil temperature. Declared for completeness; NEON soil arrays sit 9.5 km or more from the nearest drag plot, so the product is not ingested."@en ;
                 rdfs:label "soil temperature"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#StatusUncertain
:StatusUncertain rdf:type owl:NamedIndividual ,
                          :PhenophaseStatus ;
                 rdfs:comment "The observer could not determine the status. Excluded from derived timing measures."@en ;
                 rdfs:label "Uncertain"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#USANPN
:USANPN rdf:type owl:NamedIndividual ,
                 :ObservationNetwork ;
        rdfs:comment "Volunteer phenology monitoring through the Nature's Notebook programme, coordinated by the USA-NPN National Coordinating Office. Observers are dispersed and self-selected, and the coordinating office has limited ability to verify individual observer skill, so a single record carries less assurance than a NEON record while the aggregate covers far more of the country."@en ;
        rdfs:label "USA National Phenology Network"@en ;
        rdfs:seeAlso <https://www.usanpn.org/> .


###  https://bryantpollard.github.io/neon-epn/ontology#UnidentifiedHostTaxon
:UnidentifiedHostTaxon rdf:type owl:NamedIndividual ,
                                :HostTaxon ;
                       rdfs:comment "Sentinel taxon for captured animals NEON recorded without a usable species identification (an animal escaping before identification, or an incomplete record). Modelling this explicitly keeps the capture and any assay in the graph while making the taxonomic uncertainty visible, rather than silently dropping the animal."@en ;
                       rdfs:label "Unidentified host taxon"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#WindSpeed
:WindSpeed rdf:type owl:NamedIndividual ,
                    :ClimateProperty ;
           rdfs:comment "Wind speed. Declared for completeness; not currently ingested."@en ;
           rdfs:label "wind speed"@en .


###  https://bryantpollard.github.io/neon-epn/ontology#YoungNeedles
:YoungNeedles rdf:type owl:NamedIndividual ,
                       :Phenophase ;
              rdfs:comment "Aligned to 'immature unfolded true leaf present' (PPO:0002318)."@en ;
              rdfs:label "Young needles"@en ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/PPO_0002318> .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CaptureEvent
                :ClimateReading
                :DragSample
                :PathogenTest
                :PhenophaseObservation
                :VectorOccurrence
              )
] .


[ rdf:type owl:AllDisjointClasses ;
