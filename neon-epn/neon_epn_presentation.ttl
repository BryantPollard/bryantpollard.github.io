@prefix neonepn: <https://bryantpollard.github.io/neon-epn/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

#################################################################
# Ontology header
#################################################################

<https://bryantpollard.github.io/neon-epn/ontology>
    a owl:Ontology ;
    owl:versionIRI <https://bryantpollard.github.io/neon-epn/ontology/0.3.0> ;
    owl:versionInfo "0.3.0" ;
    dcterms:title "NEON-EPN Ontology: National Ecological Observatory Network Eco-Pathogen Network"@en ;
    dcterms:creator "Bryant Pollard" ;
    dcterms:created "2026-09-04"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment """Semantic layer (TBox) for the NEON-EPN capstone project. Models NEON
host-pathogen sampling events and continuous climate sensor telemetry over a dynamic
spatial hierarchy, as specializations of the W3C SOSA observation pattern. Serves as the
single schema that governs RDF ingestion (Stage 2), SHACL validation (Stage 3), SPARQL
serving (Stage 4), and the flattened Temporal Graph Benchmark export (Stage 5).

Reuse policy: SOSA is imported in full - Observation, Sampling, FeatureOfInterest,
Sensor, resultTime and hasResult are all load-bearing here. Everything else is
soft-referenced by IRI (MIREOT-style) rather than imported: GeoSPARQL, QUDT,
NCBITaxon, ENVO, and the three OWL-Time terms below. Importing OWL-Time in full
pulled in Duration, GeneralDurationDescription, DateTimeDescription, TRS and a dozen
other classes that no instance data ever used, tripling the apparent size of the
model for no benefit."""@en ;
    rdfs:seeAlso <https://bryantpollard.github.io/> ,
                 <https://www.neonscience.org/> ;
    owl:imports <http://www.w3.org/ns/sosa/> .

#################################################################
# Section 0 - Borrowed temporal terms (MIREOT: referenced, not imported)
# Only these three OWL-Time terms are used, and only to give daily-aggregated
# climate an honest phenomenon time. Point-in-time events use sosa:resultTime
# with a plain xsd:dateTime and need no temporal vocabulary at all.
#################################################################

time:Interval
    a owl:Class ;
    rdfs:label "Interval"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time#> ;
    rdfs:comment "A temporal entity with extent. Used here for the span covered by a daily climate aggregate."@en .

time:Instant
    a owl:Class ;
    rdfs:label "Instant"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time#> .

time:hasBeginning
    a owl:ObjectProperty ;
    rdfs:label "has beginning"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time#> .

time:hasEnd
    a owl:ObjectProperty ;
    rdfs:label "has end"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time#> .

time:inXSDDateTimeStamp
    a owl:DatatypeProperty ;
    rdfs:label "in XSD date-time stamp"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time#> .

#################################################################
# Section 1 - Spatial hierarchy
# NEON organizes space as EcoDomain > FieldSite > Plot. All are
# GeoSPARQL Features so geometries attach via geo:hasGeometry.
#################################################################

neonepn:SpatialUnit
    a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "Spatial unit"@en ;
    rdfs:comment "Any node of the NEON spatial hierarchy (ecoclimatic domain, field site, or plot). Subclass of geo:Feature so WKT geometries can be attached."@en .

neonepn:EcoDomain
    a owl:Class ;
    rdfs:subClassOf neonepn:SpatialUnit ;
    rdfs:label "Ecoclimatic domain"@en ;
    rdfs:comment "One of NEON's 20 ecoclimatic domains (e.g., D01 Northeast)."@en .

neonepn:FieldSite
    a owl:Class ;
    rdfs:subClassOf neonepn:SpatialUnit ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:withinSpatialUnit ;
          owl:someValuesFrom neonepn:EcoDomain ] ;
    rdfs:label "Field site"@en ;
    rdfs:comment "A NEON field site (e.g., HARV, OSBS). Every field site lies within an ecoclimatic domain."@en .

neonepn:Plot
    a owl:Class ;
    rdfs:subClassOf neonepn:SpatialUnit ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:withinSpatialUnit ;
          owl:someValuesFrom neonepn:FieldSite ] ;
    rdfs:label "Plot"@en ;
    rdfs:comment "A sampling plot within a NEON field site (e.g., a small-mammal trapping grid)."@en .

[] a owl:AllDisjointClasses ;
   owl:members ( neonepn:EcoDomain neonepn:FieldSite neonepn:Plot ) .

neonepn:withinSpatialUnit
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:subPropertyOf geo:sfWithin ;
    rdfs:domain neonepn:SpatialUnit ;
    rdfs:range  neonepn:SpatialUnit ;
    rdfs:label "within spatial unit"@en ;
    rdfs:comment "Transitive containment along the NEON spatial hierarchy (plot within site within domain). Sub-property of GeoSPARQL sfWithin so spatial reasoners interoperate."@en .

neonepn:neonDomainCode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain neonepn:EcoDomain ;
    rdfs:range  xsd:string ;
    rdfs:label "NEON domain code"@en ;
    rdfs:comment "NEON domain identifier, e.g., 'D01'."@en .

neonepn:neonSiteCode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain neonepn:FieldSite ;
    rdfs:range  xsd:string ;
    rdfs:label "NEON site code"@en ;
    rdfs:comment "Four-letter NEON site identifier, e.g., 'HARV'."@en .

neonepn:plotId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain neonepn:Plot ;
    rdfs:range  xsd:string ;
    rdfs:label "plot identifier"@en ;
    rdfs:comment "NEON plot identifier, e.g., 'HARV_001'."@en .

#################################################################
# Section 2 - Taxa and organisms
# Light-weight local Taxon class; individuals map to NCBITaxon
# by IRI (skos:exactMatch) and by curie string (ncbiTaxonId).
#################################################################

neonepn:Taxon
    a owl:Class ;
    rdfs:label "Taxon"@en ;
    rdfs:comment "A biological taxon referenced by the project. Individuals should carry a skos:exactMatch to the corresponding purl.obolibrary.org NCBITaxon IRI."@en ;
    rdfs:seeAlso obo:NCBITaxon_1 .

neonepn:HostTaxon
    a owl:Class ;
    rdfs:subClassOf neonepn:Taxon ;
    rdfs:label "Host taxon"@en ;
    rdfs:comment "A taxon acting as a pathogen host in this network (e.g., small mammal species sampled by NEON)."@en .

neonepn:PathogenTaxon
    a owl:Class ;
    rdfs:subClassOf neonepn:Taxon ;
    rdfs:label "Pathogen taxon"@en ;
    rdfs:comment "A taxon acting as a pathogen or vector-borne agent tested for by NEON assays (e.g., Borrelia burgdorferi)."@en .

[] a owl:AllDisjointClasses ;
   owl:members ( neonepn:HostTaxon neonepn:PathogenTaxon ) ;
   rdfs:comment "Disjoint within the scope of this model: no taxon plays both roles in NEON-EPN." .

neonepn:HostIndividual
    a owl:Class ;
    rdfs:subClassOf sosa:FeatureOfInterest ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:ofTaxon ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass neonepn:HostTaxon ] ;
    rdfs:label "Host individual"@en ;
    rdfs:comment "An individual captured/sampled organism (e.g., one tagged deer mouse). The feature of interest of pathogen assays."@en .

neonepn:UnidentifiedHostTaxon
    a neonepn:HostTaxon , owl:NamedIndividual ;
    rdfs:label "Unidentified host taxon"@en ;
    rdfs:comment "Sentinel taxon for captured animals NEON recorded without a usable species identification (an animal escaping before identification, or an incomplete record). Modelling this explicitly keeps the capture and any assay in the graph while making the taxonomic uncertainty visible, rather than silently dropping the animal."@en .

neonepn:ofTaxon
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain neonepn:HostIndividual ;
    rdfs:range  neonepn:HostTaxon ;
    rdfs:label "of taxon"@en ;
    rdfs:comment "Links an individual organism to its species-level taxon."@en .

neonepn:tagId
    a owl:DatatypeProperty ;
    rdfs:domain neonepn:HostIndividual ;
    rdfs:range  xsd:string ;
    rdfs:label "tag identifier"@en ;
    rdfs:comment "NEON mark-recapture tag for an individual animal."@en .

#################################################################
# Section 3 - Events and observations (SOSA specializations)
#################################################################

## 3a. Capture events (discrete biological sampling)

neonepn:CaptureEvent
    a owl:Class ;
    rdfs:subClassOf sosa:Sampling ,
        [ a owl:Restriction ;
          owl:onProperty sosa:hasFeatureOfInterest ;
          owl:someValuesFrom neonepn:HostIndividual ] ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:sampledAt ;
          owl:someValuesFrom neonepn:Plot ] ;
    rdfs:label "Capture event"@en ;
    rdfs:comment "A discrete NEON trapping/sampling act in which a host individual is captured at a plot at a point in time (sosa:resultTime)."@en .

## 3b. Pathogen assays (discrete lab results)

neonepn:PathogenPresence
    a sosa:ObservableProperty ;
    rdfs:label "pathogen presence"@en ;
    rdfs:comment "The observable property measured by a pathogen assay: presence/absence of a target pathogen in a host individual or its sample."@en .

neonepn:AssayResult
    a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( neonepn:Detected neonepn:NotDetected neonepn:Inconclusive ) ] ;
    rdfs:label "Assay result"@en ;
    rdfs:comment "Closed value set for pathogen assay outcomes. Closure is enforced here by owl:oneOf and again defensively by SHACL in Stage 3."@en .

neonepn:Detected      a neonepn:AssayResult , owl:NamedIndividual ; rdfs:label "detected"@en .
neonepn:NotDetected   a neonepn:AssayResult , owl:NamedIndividual ; rdfs:label "not detected"@en .
neonepn:Inconclusive  a neonepn:AssayResult , owl:NamedIndividual ; rdfs:label "inconclusive"@en .

[] a owl:AllDifferent ;
   owl:distinctMembers ( neonepn:Detected neonepn:NotDetected neonepn:Inconclusive ) .

neonepn:PathogenTest
    a owl:Class ;
    rdfs:subClassOf sosa:Observation ,
        [ a owl:Restriction ;
          owl:onProperty sosa:observedProperty ;
          owl:hasValue neonepn:PathogenPresence ] ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:testedForPathogen ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass neonepn:PathogenTaxon ] ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:hasAssayResult ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass neonepn:AssayResult ] ;
    rdfs:label "Pathogen test"@en ;
    rdfs:comment "Any test for the presence of one pathogen taxon in one sampled entity, yielding exactly one closed-set result at a point in time. Specialized by PathogenAssay (host blood) and TickPathogenAssay (pooled tick subsample)."@en .

neonepn:PathogenAssay
    a owl:Class ;
    rdfs:subClassOf neonepn:PathogenTest ,
        [ a owl:Restriction ;
          owl:onProperty sosa:observedProperty ;
          owl:hasValue neonepn:PathogenPresence ] ,
        [ a owl:Restriction ;
          owl:onProperty sosa:hasFeatureOfInterest ;
          owl:someValuesFrom neonepn:HostIndividual ] ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:testedForPathogen ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass neonepn:PathogenTaxon ] ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:hasAssayResult ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass neonepn:AssayResult ] ;
    rdfs:label "Host pathogen assay"@en ;
    rdfs:comment "A laboratory test (e.g., qPCR/ELISA) of one host individual's blood sample for one pathogen taxon. Source: NEON rodent-borne pathogen status, linked to trapping by bloodSampleID."@en .

### Vector (tick) sampling and testing ######################################

neonepn:TickSample
    a owl:Class ;
    rdfs:subClassOf sosa:FeatureOfInterest ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:collectedAt ;
          owl:someValuesFrom neonepn:SpatialUnit ] ;
    rdfs:label "Tick sample"@en ;
    rdfs:comment "A tick specimen collected by drag-cloth sampling at a plot and submitted for pathogen testing, identified by NEON subsampleID. In every NEON record examined (231,892 across 39 sites) individualCount is 1, so a sample is a single tick; the count is retained because the field permits pooling in principle. Unlike a host individual, a tick sample is an environmental sample with no tagged organism, so vector-borne detections attach to place rather than to an animal."@en .

neonepn:collectedAt
    a owl:ObjectProperty ;
    rdfs:domain neonepn:TickSample ;
    rdfs:range  neonepn:SpatialUnit ;
    rdfs:label "collected at"@en ;
    rdfs:comment "The spatial unit where a tick sample was collected."@en .

neonepn:individualCount
    a owl:DatatypeProperty ;
    rdfs:domain neonepn:TickSample ;
    rdfs:range  xsd:integer ;
    rdfs:label "individual count"@en ;
    rdfs:comment "Number of tick individuals in the tested subsample. Uniformly 1 in the NEON data examined; retained so that pooled testing, which the source field permits, would be representable without a schema change."@en .

neonepn:TickPathogenAssay
    a owl:Class ;
    rdfs:subClassOf neonepn:PathogenTest ,
        [ a owl:Restriction ;
          owl:onProperty sosa:hasFeatureOfInterest ;
          owl:someValuesFrom neonepn:TickSample ] ;
    rdfs:label "Tick pathogen assay"@en ;
    rdfs:comment "A laboratory test of one pooled tick subsample for one pathogen taxon. Source: NEON tick-borne pathogen status."@en .

neonepn:detectedAt
    a owl:ObjectProperty ;
    rdfs:domain neonepn:PathogenTaxon ;
    rdfs:range  neonepn:SpatialUnit ;
    rdfs:label "detected at"@en ;
    rdfs:comment "Asserted pathogen-place detection edge: the pathogen taxon was detected in a vector sample collected at this spatial unit. Materialized from each TickPathogenAssay whose hasAssayResult is Detected. This is the vector-borne counterpart of detectedIn and the second link-prediction target of the temporal graph."@en .

### Tick burden observed on captured hosts (host-vector bridge) #############

# NEON records tick attachment by life stage as presence/absence (Y/N), not as
# a count; a separate tickNumber field carries a count on the small subset of
# records where one was taken. Modelling these as integers was wrong and
# silently discarded every value.
neonepn:larvalTicksAttached
    a owl:DatatypeProperty ;
    rdfs:domain neonepn:CaptureEvent ;
    rdfs:range  xsd:boolean ;
    rdfs:label "larval ticks attached"@en .

neonepn:nymphalTicksAttached
    a owl:DatatypeProperty ;
    rdfs:domain neonepn:CaptureEvent ;
    rdfs:range  xsd:boolean ;
    rdfs:label "nymphal ticks attached"@en .

neonepn:adultTicksAttached
    a owl:DatatypeProperty ;
    rdfs:domain neonepn:CaptureEvent ;
    rdfs:range  xsd:boolean ;
    rdfs:label "adult ticks attached"@en ;
    rdfs:comment "Presence of attached ticks by life stage at capture. Bridges hosts to the vector layer: an animal carrying ticks links that host individual to the tick populations sampled by drag cloth at the same plot."@en .

neonepn:attachedTickCount
    a owl:DatatypeProperty ;
    rdfs:domain neonepn:CaptureEvent ;
    rdfs:range  xsd:integer ;
    rdfs:label "attached tick count"@en ;
    rdfs:comment "Number of attached ticks counted at capture (NEON tickNumber). Recorded on only a small fraction of captures; absence means not counted, not zero."@en .

neonepn:testedForPathogen
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain neonepn:PathogenTest ;
    rdfs:range  neonepn:PathogenTaxon ;
    rdfs:label "tested for pathogen"@en ;
    rdfs:comment "The single pathogen taxon targeted by an assay."@en .

neonepn:hasAssayResult
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain neonepn:PathogenTest ;
    rdfs:range  neonepn:AssayResult ;
    rdfs:label "has assay result"@en ;
    rdfs:comment "The single outcome of an assay, drawn from the closed AssayResult value set."@en .

## 3c. Climate readings (continuous telemetry)

neonepn:ClimateProperty
    a owl:Class ;
    rdfs:subClassOf sosa:ObservableProperty ;
    rdfs:label "Climate property"@en ;
    rdfs:comment "An observable meteorological/soil property streamed by NEON instrumentation."@en .

neonepn:AirTemperature   a neonepn:ClimateProperty , owl:NamedIndividual ; rdfs:label "air temperature"@en .
neonepn:SoilTemperature  a neonepn:ClimateProperty , owl:NamedIndividual ; rdfs:label "soil temperature"@en .
neonepn:RelativeHumidity a neonepn:ClimateProperty , owl:NamedIndividual ; rdfs:label "relative humidity"@en .
neonepn:Precipitation    a neonepn:ClimateProperty , owl:NamedIndividual ; rdfs:label "precipitation"@en .
neonepn:WindSpeed        a neonepn:ClimateProperty , owl:NamedIndividual ; rdfs:label "wind speed"@en .

neonepn:ClimateReading
    a owl:Class ;
    rdfs:subClassOf sosa:Observation ,
        [ a owl:Restriction ;
          owl:onProperty sosa:observedProperty ;
          owl:someValuesFrom neonepn:ClimateProperty ] ,
        [ a owl:Restriction ;
          owl:onProperty sosa:madeBySensor ;
          owl:someValuesFrom neonepn:ClimateSensor ] ,
        [ a owl:Restriction ;
          owl:onProperty sosa:hasResult ;
          owl:someValuesFrom qudt:QuantityValue ] ;
    rdfs:label "Climate reading"@en ;
    rdfs:comment "One measurement from the climate telemetry. Native-resolution readings carry sosa:resultTime (an instant). Daily aggregates additionally carry sosa:phenomenonTime pointing at a time:Interval spanning the day, because a daily mean is not observed at an instant. Results use QUDT QuantityValue (value + unit), or sosa:hasSimpleResult in lean mode."@en .

neonepn:ClimateSensor
    a owl:Class ;
    rdfs:subClassOf sosa:Sensor ,
        [ a owl:Restriction ;
          owl:onProperty neonepn:deployedAt ;
          owl:someValuesFrom neonepn:SpatialUnit ] ;
    rdfs:label "Climate sensor"@en ;
    rdfs:comment "A NEON instrument streaming climate readings from a deployment location."@en .

neonepn:deployedAt
    a owl:ObjectProperty ;
    rdfs:domain neonepn:ClimateSensor ;
    rdfs:range  neonepn:SpatialUnit ;
    rdfs:label "deployed at"@en ;
    rdfs:comment "The spatial unit where a sensor is installed."@en .

[] a owl:AllDisjointClasses ;
   owl:members ( neonepn:PathogenTest neonepn:ClimateReading neonepn:CaptureEvent ) .

[] a owl:AllDisjointClasses ;
   owl:members ( neonepn:PathogenAssay neonepn:TickPathogenAssay ) .

[] a owl:AllDisjointClasses ;
   owl:members ( neonepn:HostIndividual neonepn:TickSample ) .

#################################################################
# Section 4 - Cross-cutting event properties
#################################################################

neonepn:sampledAt
    a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( sosa:Observation sosa:Sampling ) ] ;
    rdfs:range  neonepn:SpatialUnit ;
    rdfs:label "sampled at"@en ;
    rdfs:comment "The spatial unit at which an observation or sampling act occurred. Combined with withinSpatialUnit, every event resolves upward to site and domain."@en .

neonepn:detectedIn
    a owl:ObjectProperty ;
    rdfs:domain neonepn:PathogenTaxon ;
    rdfs:range  neonepn:HostIndividual ;
    rdfs:label "detected in"@en ;
    rdfs:comment "Asserted pathogen-host detection edge: the pathogen taxon was detected in the host individual. Materialized during Stage 2 from each PathogenAssay whose hasAssayResult is Detected; this is the primary positive edge type of the temporal graph and the main link-prediction target."@en .

neonepn:hostOf
    a owl:ObjectProperty ;
    owl:inverseOf neonepn:detectedIn ;
    rdfs:label "host of"@en .

# Temporal note (documentation, not an axiom):
# Discrete events (CaptureEvent, PathogenTest) carry sosa:resultTime (xsd:dateTime):
# a capture or an assay happens at a point in time.
# Daily-aggregated ClimateReadings also carry sosa:phenomenonTime -> time:Interval,
# so a daily mean is not falsely asserted to have been observed at midnight. Day
# intervals are minted once per calendar day and shared by every reading that day,
# which keeps the correction cheap (a few triples per day, not per reading).
# Raw UNIX timestamps are preserved at export (Stage 5); the ontology stays unit-free.
